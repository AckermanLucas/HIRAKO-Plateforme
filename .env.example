# ============================================================
# HIRAKO — Configuration Spotify
# ============================================================
#
# Pour activer l'intégration Spotify :
# 1. Allez sur https://developer.spotify.com/dashboard
# 2. Créez une application
# 3. Ajoutez votre URL en "Redirect URIs" (ex: http://localhost:3000)
# 4. Copiez le Client ID ci-dessous
# 5. Redémarrez l'app : npm start
#
# IMPORTANT : Seul le CLIENT_ID est nécessaire (flux PKCE, pas de secret).

REACT_APP_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
REACT_APP_SPOTIFY_REDIRECT_URI=http://localhost:3000

# Pour la production, changez l'URI de redirection :
# REACT_APP_SPOTIFY_REDIRECT_URI=https://votre-domaine.com
